@baseUrl = http://localhost:8080

### Health
GET {{baseUrl}}/actuator/health

### Dashboard summary
GET {{baseUrl}}/api/dashboard/summary

### Effective monitoring rules
GET {{baseUrl}}/api/rules

### Create a normal transaction
POST {{baseUrl}}/api/transactions
Content-Type: application/json

{
  "accountId": "ACC-100",
  "payeeId": "PAYEE-100",
  "amount": 250.00,
  "currency": "INR",
  "description": "Monthly service"
}

### Create a high-amount transaction
POST {{baseUrl}}/api/transactions
Content-Type: application/json

{
  "accountId": "ACC-200",
  "payeeId": "PAYEE-200",
  "amount": 15000.00,
  "currency": "INR",
  "description": "High amount example"
}

### Search transactions
GET {{baseUrl}}/api/transactions?search=ACC-200&minAmount=10000&size=20

### List open alerts
GET {{baseUrl}}/api/alerts?status=OPEN&size=20

### Replace 1 with a real alert ID
GET {{baseUrl}}/api/alerts/1

### Acknowledge an open alert
PATCH {{baseUrl}}/api/alerts/1/status
Content-Type: application/json

{
  "targetStatus": "ACKNOWLEDGED",
  "resolutionNotes": null
}

### Start investigation
PATCH {{baseUrl}}/api/alerts/1/status
Content-Type: application/json

{
  "targetStatus": "INVESTIGATING",
  "resolutionNotes": null
}

### Close after investigation
PATCH {{baseUrl}}/api/alerts/1/status
Content-Type: application/json

{
  "targetStatus": "CLOSED",
  "resolutionNotes": "Confirmed legitimate transaction"
}
