# Docker Compose reads these values. deploy-linux.sh creates .env automatically.
DB_PASSWORD=replace-with-a-strong-password
APP_PORT=8080

# These are only needed when running the application outside Docker.
DB_URL=jdbc:mysql://localhost:3306/secureflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=secureflow
