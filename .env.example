# Do not copy this file unchanged. deploy-linux.sh creates .env with strong,
# random database passwords and private file permissions automatically.
SECUREFLOW_DB_PASSWORD=
SECUREFLOW_DB_ROOT_PASSWORD=

# Keep 127.0.0.1 for WSL/local use. A controlled remote VM may use 0.0.0.0.
SECUREFLOW_BIND_ADDRESS=127.0.0.1
SECUREFLOW_PORT=8080
